[Unit]
Description=Local Rust telemetry and three-screen dashboards
After=network.target
RequiresMountsFor=/srv/rust

[Service]
User=rust-telemetry
Group=rust-telemetry
ExecStart=/usr/bin/python3 /opt/rustberrypi/telemetry/server.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/rust/data/.rustberrypi-telemetry
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077
MemoryMax=192M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
